# =========================================================================
# Plantilla de variables de entorno para DESARROLLO.
#
#   1. Copia este archivo a ".env"  (cp .env.example .env)
#   2. Rellena los secretos con valores propios.
#
# ".env" está en .gitignore: NUNCA se sube al repositorio.
# Este archivo (.env.example) sí se sube, por eso NO contiene secretos reales.
# =========================================================================


# -------------------------------------------------------------------------
# CONFIGURACIÓN (no secreta)
# -------------------------------------------------------------------------

# Entorno de ejecución: development | test | production
APP_ENV=development

# Nivel de logs del backend: debug | info | warning | error
LOG_LEVEL=info

# Puertos publicados en tu máquina (cámbialos si ya están ocupados)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Base de datos
POSTGRES_DB=fichaje
POSTGRES_USER=fichaje


# -------------------------------------------------------------------------
# SECRETOS (pon valores propios; estos son solo ejemplos de desarrollo)
# -------------------------------------------------------------------------

# Contraseña del usuario de PostgreSQL
POSTGRES_PASSWORD=change-me

# Cadena de conexión que usará el backend.
# Dentro de Docker el host es "db" (nombre del servicio en docker-compose.yml).
# Si ejecutas el backend directamente en tu máquina, usa "localhost".
DATABASE_URL=postgresql+psycopg://fichaje:change-me@db:5432/fichaje

# Firma de los JWT de administración (se usará en la fase de autenticación).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Clave HMAC para los PINs de empleados (se usará en la fase de PIN).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
PIN_HMAC_SECRET=
